---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SwiperNavButton from "./SwiperNavButton.astro";

type Album = {
  id: string;
  label: string;
  date?: string;
  images: ImageMetadata[];
};

const albumImports = import.meta.glob(
  "../assets/img/trees/downres/*/*.{webp,png,jpg,jpeg}",
  { eager: true }
);

const ALBUMS_CONFIG = [
  {id: "ep7", label: "Tootsie's 7", date: "2026-10-03"},
  { id: "ep666", label: "Tootsie's 666", date: "2026-06-06" },
  { id: "ep4", label: "Tootsie's 4", date: "2025-06-06" },
  { id: "ep3", label: "Tootsie's 3", date: "2024-05-31" },
  { id: "ep2", label: "Tootsie's 2", date: "2023-10-13" },
  { id: "ep1", label: "Tootsie's 1", date: "2023-06-30" },
];

const albumMap = Object.entries(albumImports).reduce<
  Record<string, Album>
>((albumMap, [path, module]) => {
  const segments = path.split("/");
  const folder = segments.at(-2);
  const image = (module as { default: ImageMetadata }).default;

  if (!folder || !image) {
    return albumMap;
  }

  if (!albumMap[folder]) {
    albumMap[folder] = {
      id: folder,
      label: folder.toUpperCase(),
      images: [],
    };
  }

  albumMap[folder].images.push(image);
  return albumMap;
}, {});

const albumData = ALBUMS_CONFIG
  .map(({ id, label, date }) => {
    const album = albumMap[id];
    if (!album) return null;
    return {
      ...album,
      label,
      date,
      images: [...album.images].sort((a, b) => a.src.localeCompare(b.src)),
    };
  })
  .filter(Boolean) as Album[];
// Split in filename order at the point that best balances the displayed row widths.
function photoRows(images: ImageMetadata[]) {
  const widths = images.map(image => 320 * image.width / image.height + 10);
  const total = widths.reduce((sum, width) => sum + width, 0);
  let split = images.length;
  let bestDifference = Infinity;
  let firstWidth = 0;
  for (let i = 1; i < images.length; i++) {
    firstWidth += widths[i - 1];
    const difference = Math.abs(total - 2 * firstWidth);
    if (difference < bestDifference) {
      bestDifference = difference;
      split = i;
    }
  }
  return [images.slice(0, split), images.slice(split)].filter(row => row.length);
}
---

  {albumData.length === 0 ? (
    <p class="text-center text-sm opacity-70">
      Behind-the-scenes photos coming soon.
    </p>
  ) : (
    <div class="album-gallery">
      <div class="album-toggle">
        {albumData.map((album, index) => (
          <button
            type="button"
            class={`album-toggle__btn tab-toggle__btn ${index === 0 ? "is-active" : ""}`}
            data-album-toggle
            data-target={album.id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span class="toggle__label">{album.label}</span>
            {album.date && (
              <span class="toggle__date">
                {new Date(album.date).toLocaleDateString(undefined, {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                  timeZone: "UTC",
                })}
              </span>
            )}
          </button>
        ))}
      </div>
      <div class="album-carousels">
        {albumData.map((album, index) => {
          const navNext = `album-nav-next-${index}`;
          const navPrev = `album-nav-prev-${index}`;
          return (
            <div
              class="album-carousels__panel"
              data-album-panel
              data-album={album.id}
              hidden={index === 0 ? undefined : true}
            >
              <SwiperNavButton
                direction="prev"
                class={`${navPrev}`}
                ariaLabel="Previous slide"
              />
              <div
                class="album-scroll not-content"
                id={`album-scroll-${album.id}`}
                data-album-scroll
                tabindex="0"
                role="region"
                aria-label={`${album.label} photos`}
              >
                <div class="album-track">
                  {photoRows(album.images).map(row => (
                    <div class="album-row">
                      {row.map((image) => (
                        <Image
                          src={image}
                          alt={`BTS ${album.label} still`}
                          height={320}
                          widths={[240, 360, 480, 720]}
                          sizes={`(min-width: 1024px) ${Math.round(320 * image.width / image.height)}px, ${Math.round(256 * image.width / image.height)}px`}
                          loading="lazy"
                          draggable="false"
                          data-modal-image
                          data-modal-full={image.src}
                          style={`--photo-ratio: ${image.width / image.height}`}
                          class="album-photo cursor-zoom-in"
                        />
                      ))}
                    </div>
                  ))}
                </div>
              </div>
              <SwiperNavButton
                direction="next"
                class={`${navNext}`}
                ariaLabel="Next slide"
              />
            </div>
          );
        })}
      </div>
      <script type="module" is:inline>
        document.querySelectorAll(".album-gallery").forEach(gallery => {
          const toggles = [...gallery.querySelectorAll("[data-album-toggle]")];
          const panels = [...gallery.querySelectorAll("[data-album-panel]")];
          const updates = new Map();

          panels.forEach(panel => {
            const scroller = panel.querySelector("[data-album-scroll]");
            const [previous, next] = panel.querySelectorAll(".nav-button");
            previous.setAttribute("aria-controls", scroller.id);
            next.setAttribute("aria-controls", scroller.id);
            const update = () => {
              previous.disabled = scroller.scrollLeft <= 1;
              next.disabled = scroller.scrollLeft >= scroller.scrollWidth - scroller.clientWidth - 1;
            };
            updates.set(panel, update);
            const scrollPage = direction => scroller.scrollBy({
              left: direction * scroller.clientWidth * 0.85,
              behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
            });
            previous.addEventListener("click", () => scrollPage(-1));
            next.addEventListener("click", () => scrollPage(1));
            scroller.addEventListener("scroll", update, { passive: true });
            new ResizeObserver(update).observe(scroller);

            // Touch uses native scrolling. Mouse dragging must not open the image modal.
            let drag = null;
            let suppressClick = false;
            scroller.addEventListener("pointerdown", event => {
              suppressClick = false;
              if (event.pointerType !== "mouse" || event.button !== 0) return;
              drag = { id: event.pointerId, x: event.clientX, left: scroller.scrollLeft, moved: false };
            });
            scroller.addEventListener("pointermove", event => {
              if (!drag || event.pointerId !== drag.id) return;
              const distance = event.clientX - drag.x;
              if (!drag.moved && Math.abs(distance) < 6) return;
              if (!drag.moved) {
                drag.moved = true;
                scroller.setPointerCapture(event.pointerId);
                scroller.classList.add("is-dragging");
              }
              scroller.scrollLeft = drag.left - distance;
              event.preventDefault();
            });
            const endDrag = () => {
              suppressClick = drag?.moved ?? false;
              drag = null;
              scroller.classList.remove("is-dragging");
            };
            scroller.addEventListener("pointerup", endDrag);
            scroller.addEventListener("pointercancel", endDrag);
            scroller.addEventListener("lostpointercapture", () => {
              if (drag) endDrag();
            });
            scroller.addEventListener("pointerleave", () => {
              if (drag && !drag.moved) drag = null;
            });
            scroller.addEventListener("click", event => {
              if (suppressClick) {
                event.preventDefault();
                event.stopImmediatePropagation();
                suppressClick = false;
              }
            }, true);
            update();
          });

          toggles.forEach(btn => btn.addEventListener("click", () => {
            toggles.forEach(toggle => {
              const active = toggle === btn;
              toggle.classList.toggle("is-active", active);
              toggle.setAttribute("aria-pressed", String(active));
            });
            panels.forEach(panel => {
              const active = panel.dataset.album === btn.dataset.target;
              panel.hidden = !active;
              if (active) updates.get(panel)();
            });
          }));
        });
      </script>
    </div>
  )}


<style>
  .album-carousels__panel {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .album-carousels__panel[hidden] {
    display: none;
  }

  .album-scroll {
    --photo-height: 16rem;
    flex: 1 1 0;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-secondary) transparent;
    user-select: none;
  }

  .album-scroll:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }

  .album-track,
  .album-row {
    display: flex;
    gap: 10px;
    width: max-content;
  }

  .album-row {
    display: contents;
  }

  .album-photo {
    flex: none;
    height: var(--photo-height);
    width: calc(var(--photo-height) * var(--photo-ratio));
    max-width: none;
    object-fit: contain;
  }

  .album-scroll.is-dragging,
  .album-scroll.is-dragging .album-photo {
    cursor: grabbing;
  }

  @media (min-width: 1024px) {
    .album-scroll {
      --photo-height: 20rem;
    }

    .album-track {
      flex-direction: column;
    }

    .album-row {
      display: flex;
    }
  }
</style>
